{
  "rules": {
    ".read": false,
    ".write": false,
    "unlockedIds": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'R0XtUV4I1pdOhBTMJLiQEpuH7e32'"
    },
    "questionEdits": {
      ".read": true,
      "$id": {
        ".write": "auth != null && auth.uid === 'R0XtUV4I1pdOhBTMJLiQEpuH7e32'",
        ".validate": "newData.hasChildren(['question', 'answer', 'song', 'sermon'])",
        "question": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 300"
        },
        "answer": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 3000"
        },
        "song": {
          ".validate": "newData.isString() && newData.val().length <= 300"
        },
        "sermon": {
          ".validate": "newData.isString() && newData.val().length <= 300"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "scores": {
      ".read": "auth != null",
      ".indexOn": ["points"],
      "$uid": {
        "name": {
          ".write": "auth != null && auth.uid === $uid && newData.exists()",
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
        },
        "points": {
          ".write": "auth != null && auth.uid === $uid && newData.exists() && newData.isNumber() && newData.val() >= 0 && (!data.exists() ? newData.val() === 0 : newData.val() >= data.val() && newData.val() <= data.val() + 20)"
        },
        "$other": {
          ".write": false
        }
      }
    }
  }
}
